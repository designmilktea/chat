rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && recordId.matches('^[a-zA-Z0-9:_-]{1,180}$')
        && request.resource.data.keys().hasOnly(['kind', 'body'])
        && request.resource.data.kind in ['meta','category','chat','message','thought','hypothesis','trash']
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 300000;
      allow delete: if owner(uid);
    }
    match /users/{uid}/sync/state {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision','updatedAt'])
        && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision','updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
    }
  }
}
